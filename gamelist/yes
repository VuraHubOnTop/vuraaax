local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- === KONFIGURASI LOKASI MANCING ===
-- Ganti koordinat ini dengan posisi area mancing yang kamu inginkan
local FISHING_SPOT = Vector3.new(0, 0, 0) -- Contoh: Vector3.new(100, 10, -50)

-- === FUNGSI TELEPORT ===
local function teleportToFishingSpot()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(FISHING_SPOT)
        print("[Delta] Teleported to fishing spot.")
    else
        warn("[Delta] Character not ready.")
    end
end

-- === FUNGSI INSTANT FISHING ===
-- Mencoba mengirim remote event yang umum digunakan untuk memancing
local function instantFish()
    -- Cari remote event yang berkaitan dengan fishing
    local remoteNames = {"Fish", "Fishing", "CatchFish", "Reel", "Cast"}
    local foundRemote = nil

    for _, remoteName in ipairs(remoteNames) do
        local remote = ReplicatedStorage:FindFirstChild(remoteName, true)
        if remote and remote:IsA("RemoteEvent") then
            foundRemote = remote
            break
        end
    end

    if foundRemote then
        -- Kirim remote event untuk memancing secara instan
        foundRemote:FireServer()
        print("[Delta] Instant fishing triggered via:", foundRemote:GetFullName())
    else
        warn("[Delta] Fishing remote not found. Trying alternative method...")
        -- Metode alternatif: simulasikan input keyboard "E" (tombol default memancing)
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        print("[Delta] Simulated fishing input.")
    end
end

